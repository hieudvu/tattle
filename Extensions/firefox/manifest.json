{
  "manifest_version": 3,
  "name": "Tattle",
  "short_name": "Tattle",
  "description": "Shows which browser tab is playing sound, and lets Tattle mute, pause, close or focus it.",
  "version": "0.1.0",
  "permissions": ["tabs", "nativeMessaging", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tattle@hieuvd.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
